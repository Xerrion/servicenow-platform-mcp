# Copy this file to .env.local and replace the placeholders.

# ServiceNow OAuth authorization-code client: confidential secret or public PKCE S256.
# Browser and MCP process must run on the same machine.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_OAUTH_CLIENT_ID=your-client-id
# Required for a confidential app. Leave empty only for a confirmed public app.
# Non-empty selects confidential flow without PKCE; empty selects public PKCE S256.
# Public PKCE compatibility with Yokohama is unverified.
# Supply the actual secret privately; never commit it or place it in a browser URL.
SERVICENOW_OAUTH_CLIENT_SECRET=
# Required by this client in both modes, not established as required by Yokohama.
# Keep useraccount when allowed by the ServiceNow application.
# Do not add offline_access unless the administrator confirms it is supported.
SERVICENOW_OAUTH_SCOPE=useraccount
# Register this exact URI on the ServiceNow application. Port range: 1024-65535.
SERVICENOW_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
SERVICENOW_OAUTH_TIMEOUT_SECONDS=180
# Remove legacy API-key/username/password settings. Tokens remain memory-only.

# Tool package and environment
MCP_TOOL_PACKAGE=full
SERVICENOW_ENV=dev

# Query safety
MAX_ROW_LIMIT=100
LARGE_TABLE_NAMES_CSV=syslog,sys_audit,sys_log_transaction,sys_email_log

# HTTP and metadata performance
HTTPX_TIMEOUT_SECONDS=30
METADATA_CACHE_TTL_SECONDS=300

# Optional error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=
