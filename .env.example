# Copy this file to .env.local and replace the placeholders.
# Keep .env.local local; do not commit it.

# ServiceNow Application Registry: Public Client=true, authorization code with PKCE S256.
# Browser and MCP process must run on the same machine.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_OAUTH_CLIENT_ID=your-public-client-id
# Optional; defaults to useraccount. Enable the selected scope on the ServiceNow application.
# SERVICENOW_OAUTH_SCOPE=useraccount
# Register this exact URI on the ServiceNow application. Port range: 1024-65535.
SERVICENOW_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
SERVICENOW_OAUTH_TIMEOUT_SECONDS=180
# Remove SERVICENOW_API_KEY, SERVICENOW_USERNAME, and SERVICENOW_PASSWORD.
# Non-empty legacy values fail startup. A stale SERVICENOW_OAUTH_CLIENT_SECRET is ignored; remove it.
# The first tool call that needs ServiceNow opens browser authorization as the intended user.
# Default memory mode keeps access and refresh tokens in this process only.
# Optional native OS credential store. Persists ONLY refresh tokens, for up to 30 days.
# SERVICENOW_OAUTH_CACHE=os
# Use cache-enabled processes sequentially. Never use plaintext keyring backends.
# An initial normal OAuth login must populate the cache. Opting out does not delete it.
# Clear only this configuration's entry: uv run python -m servicenow_mcp.credential_cache clear
# REST calls use Bearer headers, never tokens in URLs. A REST 401 is not replayed; the next call attempts refresh.
# REST API access policies must allow the intended OAuth Bearer requests. See INSTALL.md.

# Tool package and environment
MCP_TOOL_PACKAGE=readonly
SERVICENOW_ENV=prod

# Query safety
MAX_ROW_LIMIT=100
LARGE_TABLE_NAMES_CSV=syslog,sys_audit,syslog_transaction,sys_email_log

# HTTP and metadata performance
HTTPX_TIMEOUT_SECONDS=30
METADATA_CACHE_TTL_SECONDS=300

# Optional error tracking. Leave both variables unset when Sentry is not used.
# SENTRY_DSN=https://example.invalid/project
# SENTRY_ENVIRONMENT=dev
